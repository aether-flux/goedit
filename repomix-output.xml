type KeyReader struct {
	ch chan byte
}

func NewKeyReader() *KeyReader {
	kr := &KeyReader{ch: make(chan byte, 64)}

	go func() {
		r := bufio.NewReader(os.Stdin)
		for {
			b, err := r.ReadByte()
			if err != nil {
				close(kr.ch)
				return
			}
			kr.ch <- b
		}
	}()

	return kr
}

func (kr *KeyReader) readByte() (byte, error) {
	b, ok := <-kr.ch
	if !ok {
		return 0, io.EOF
	}
	return b, nil
}

func (kr *KeyReader) next() (byte, bool) {
	select {
	case b, ok := <-kr.ch:
		return b, ok
	case <-time.After(50 * time.Millisecond):
		return 0, false
	}
}

func (kr *KeyReader) ReadKey() (int, error) {
	b, err := kr.readByte()
	if err != nil {
		return 0, err
	}

	if b != '\x1b' {
		return int(b), nil
	}

	s0, ok := kr.next()
	if !ok {
		return '\x1b', nil
	}

	s1, ok := kr.next()
	if !ok {
		return '\x1b', nil
	}

	switch s0 {
	case '[':
		if s1 >= '0' && s1 <= '9' {
			if s2, ok := kr.next(); !ok || s2 != '~' {
				return '\x1b', nil
			}

			switch s1 {
			case '1', '7':
				return HOME, nil
			case '3':
				return DELETE, nil
			case '4', '8':
				return END, nil
			case '5':
				return PAGE_UP, nil
			case '6':
				return PAGE_DOWN, nil
			}
		} else {
			switch s1 {
			case 'A':
				return ARROW_UP, nil
			case 'B':
				return ARROW_DOWN, nil
			case 'C':
				return ARROW_RIGHT, nil
			case 'D':
				return ARROW_LEFT, nil
			case 'H':
				return HOME, nil
			case 'F':
				return END, nil
			}
		}
	case '0':
		switch s1 {
		// case 'A':
		// 	return ARROW_UP, nil
		// case 'B':
		// 	return ARROW_DOWN, nil
		// case 'C':
		// 	return ARROW_RIGHT, nil
		// case 'D':
		// 	return ARROW_LEFT, nil
		case 'H':
			return HOME, nil
		case 'F':
			return END, nil
		}
	}

	return '\x1b', nil
}

var quittimes int = quit_limit - 1

func editorPrompt(prompt string, cb func(out string, c int)) string {
	var out []byte
	// kr := NewKeyReader()

	for {
		setStatusMessage(fmt.Sprintf(prompt, string(out)))
		refreshScreen()

		c, err := kr.ReadKey()
		if err != nil {
			safeExit(err)
		}

		switch {
		case c == '\r':
			if len(out) > 0 {
				setStatusMessage("")
				outStr := string(out)
				if cb != nil {
					cb(outStr, c)
				}
				return outStr
			}
		case c == BACKSPACE || c == DELETE:
			if len(out) > 0 {
				out = out[:len(out)-1]
			}
		case c == '\x1b':
			setStatusMessage("")
			if cb != nil {
				cb(string(out), c)
			}
			return ""
		case c >= 32 && c < 127:
			out = append(out, byte(c))
			// outStr := string(out)
			// if cb != nil {
			// 	cb(outStr, c)
			// }

			if cb != nil {
				cb(string(out), c)
			}
		}
	}
}

func processKey(kr *KeyReader) error {
	k, err := kr.ReadKey()

	if err == io.EOF {
		safeExit(nil)
	} else if err != nil {
		safeExit(err)
	}

	switch k {
	case ARROW_UP, ARROW_DOWN, ARROW_RIGHT, ARROW_LEFT, PAGE_UP, PAGE_DOWN, HOME, END, DELETE, BACKSPACE:
		handleSpecialKeys(k)
	case int(ctrl('q')):
		if globalState.dirty > 0 && quittimes > 0 {
			msg := fmt.Sprintf("WARN: Unsaved changes, press <C-q> %d more times to quit without saving", quittimes)
			setStatusMessage(msg)
			quittimes -= 1
			return nil
		}
		_, _ = fmt.Fprint(os.Stdout, "\x1b[2J")
		safeExit(nil)
	// case 'h', 'j', 'k', 'l', 'G', ctrl('g'), '0', '$':
	// 	moveCursor(int(k))
	case int(ctrl('f')):
		editorFind()
	case int(ctrl('s')):
		editorSave()
	case '\r':
		insertNewline()
	default:
		insertChar(byte(k))
	}

	var row string
	if globalState.cy >= globalState.nrows {
		row = ""
	} else {
		row = globalState.trow[globalState.cy].str
	}
	if globalState.cx > len(row) {
		globalState.cx = len(row)
	}

	quittimes = quit_limit - 1
	return nil
}

