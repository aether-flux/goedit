const quit_limit = 2

func ctrl(c byte) byte {
	return (c & 31)
}

const (
	BACKSPACE  = 127
	ARROW_LEFT = 1000 + iota
	ARROW_RIGHT
	ARROW_UP
	ARROW_DOWN
	PAGE_UP
	PAGE_DOWN
	HOME
	END
	DELETE
)

